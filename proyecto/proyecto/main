import gradio as gr

lista_clientes = []
class cliente:
    def __init__(self, nombre, marca, fecha_entrada, fecha_salida, numero_piesas, grado_daño):
        self.nombre = nombre
        self.marca = marca
        self.fecha_entrada = fecha_entrada
        self.fecha_salida = fecha_salida
        self.numero_piesas = numero_piesas
        self.grado_daño = grado_daño

   def mostrar_datos(self):
     return f"Nombre: {self.nombre}\nMarca: {self.marca}\nFecha de entrada: {self.fecha_entrada}\nFecha de salida: {self.fecha_salida}\nNúmero de piezas: {self.numero_piesas}\nGrado de daño: {self.grado_daño}"
        
    def agregar_cliente(nombre, marca, fecha_entrada, fecha_salida, numero_piesas, grado_daño):
        nuevocli = cliente(
            nombre,
            marca,
            fecha_entrada,
            fecha_salida,
            numero_piesas,
            grado_daño
        )
        
    
    
      
with gr.Blocks() as interfaz:
    #texbox
    
    nombre = gr.Textbox(label="Nombre del cliente")
    marca = gr.Textbox(label="Marca del vehículo")
    fecha_entrada = gr.Textbox(label="Fecha de entrada del vehículo, 1/10/2026")
    fecha_salida = gr.Textbox(label="Fecha de salida del vehículo")
    numero_piesas = gr.Textbox(label="Número de piezas a reparar")
    grado_daño = gr.Dropdow(choices=["Bajo", "Medio", "Alto", "Remplazo"], label="Grado de daño")
    
    #botones
    button=gr.Button("Agregar cliente")
    button.click(fn=agregar_cliente,variant="primary")
    button.click(fn=agregar_cliente, inputs=[nombre, marca, fecha_entrada, fecha_salida, numero_piesas, grado_daño], outputs=mostrar_datos)
    button=gr.Button("Mostrar datos del cliente")
    button.click(fn=mostrar_datos,outputs=mostrar_datos)
    
    #texbox 
    
    nombre = gr.Textbox(label="Nombre del cliente")
    marca = gr.Textbox(label="Marca del vehículo")
    fecha_entrada = gr.Textbox(label="Fecha de entrada del vehículo")
    fecha_salida = gr.Textbox(label="Fecha de salida del vehículo")
    numero_piesas = gr.Textbox(label="Número de piezas a reparar")
    grado_daño = gr.Textbox(label="Grado de daño del vehículo")

    interfaz.launch()