import gradio as gr
import pandas as pd
df=pd.read_csv("clientes.csv")

class cliente:
    def __init__(self, nombre, marca, fecha_entrada, fecha_salida, numero_piesas, grado_daño):
        self.nombre = nombre
        self.marca = marca
        self.fecha_entrada = fecha_entrada
        self.fecha_salida = fecha_salida
        self.numero_piesas = numero_piesas
        self.grado_daño = grado_daño

    def mostrar_datos(self):
        print(f"Nombre: {self.nombre}")
        print(f"Marca: {self.marca}")
        print(f"Fecha de entrada: {self.fecha_entrada}")
        print(f"Fecha de salida: {self.fecha_salida}")
        print(f"Número de piezas: {self.numero_piesas}")
        print(f"Grado de daño: {self.grado_daño}")
    
    def agregar_cliente(nombre, marca, fecha_entrada, fecha_salida, numero_piesas, grado_daño):
        nuevocli = cliente(
            nombre,
            marca,
            fecha_entrada,
            fecha_salida,
            numero_piesas,
            grado_daño
        )
